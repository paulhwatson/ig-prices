# Copy to .env and fill in real values. .env is gitignored - never commit real secrets.
#
# If these are not set here, prices/settings.py falls back to ~/trading/.env,
# so on this machine the existing IG demo login is picked up without copying it
# into a second file.
#
# Demo credentials: this app only reads market data, so it has no business
# holding live ones.

IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_DEMO_API_KEY=
# Used as the Lightstreamer username by `prices stream`.
IG_DEMO_ACC_NUMBER=
